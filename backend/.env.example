# Copia este archivo como ".env" y ajusta los valores.

# Conexión a MySQL (AMPPS). Formato:
#   mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?charset=utf8mb4
# En AMPPS el usuario por defecto es "root" y la contraseña "mysql".
DATABASE_URL=mysql+pymysql://root:mysql@localhost:3306/evesat_clientes?charset=utf8mb4

# Si dejas DATABASE_URL vacío, se usa un archivo SQLite local (evesat.db) para pruebas rápidas.

# Orígenes que pueden llamar a la API (el frontend). Separa varios con coma.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
